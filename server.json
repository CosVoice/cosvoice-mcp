      ]
    },
    {
      "src": "https://cosvoice.com/logo.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/CosVoice/cosvoice-mcp",
